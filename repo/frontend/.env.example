# Backend API Base URL for production
# In local development, leave this commented out or unset to use the Vite dev server proxy (/api/v1)
# In production on Vercel, set this to your deployed Render backend URL + /api/v1
# Example: https://crojyan-backend.onrender.com/api/v1
VITE_API_BASE_URL=https://your-backend-app.onrender.com/api/v1
