PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname
JWT_SECRET=your_minimum_32_character_jwt_secret_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Reverse proxy hops count (integer). Must equal the number of reverse proxies in front of the app
# (e.g. 1 on Render/Railway/Heroku/Vercel serverless gateway). Default is 1 when NODE_ENV=production, 0 otherwise.
# You will confirm the right value in the hosting platform's docs. Never set to 'true'.
TRUST_PROXY_HOPS=1

ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=your_initial_admin_password

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
